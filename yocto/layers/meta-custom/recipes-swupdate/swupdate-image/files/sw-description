/*
 * sw-description for STM32MP257F-DK dual A/B OTA update.
 *
 * Partition layout (by GPT label):
 *   boot-a / boot-b   : FAT32, kernel + DTB  (U-Boot uses fatload)
 *   rootfs-a / rootfs-b : ext4, root filesystem
 *   uenv               : raw, U-Boot environment
 *
 * CPIO order in the .swu must match the images order within each copy:
 *   1. stm32mp257f-custom-image.ext4.gz  (rootfs, compressed raw)
 *   2. fitImage                          (staged to /tmp, then mounted-copy by script)
 *   3. stm32mp257f-dk.dtb                (staged to /tmp, then mounted-copy by script)
 *   Scripts (post-CPIO, run after all images): update-boot-[ab].sh, post-update.sh
 *
 * Usage:
 *   swupdate-client -e "stable,copy2" update.swu   # currently on slot A → write B
 *   swupdate-client -e "stable,copy1" update.swu   # currently on slot B → write A
 *   Or use scripts/ota-update.sh which selects the inactive slot automatically.
 */
software =
{
    version = "@@VERSION@@";
    hardware-compatibility = ["1.0"];

    /*
     * stable/copy1 → writes slot A.  Select when currently running slot B.
     * stable/copy2 → writes slot B.  Select when currently running slot A.
     */
    stable: {

        copy1: {
            images: (
                {
                    filename   = "stm32mp257f-custom-image-@@MACHINE@@.rootfs.ext4.gz";
                    type       = "raw";
                    compressed = "zlib";
                    device     = "/dev/disk/by-partlabel/rootfs-a";
                    sha256     = "";
                },
                {
                    /*
                     * Stage kernel Image to tmpfs; update-boot-a.sh mounts the FAT32
                     * partition and copies it as "fitImage" (the name boot.cmd expects).
                     * Use rawfile (not raw) — raw requires an existing block device;
                     * rawfile creates the target path on the filesystem.
                     */
                    filename = "Image";
                    type     = "rawfile";
                    path     = "/tmp/Image.swu.tmp";
                    sha256   = "";
                },
                {
                    filename = "stm32mp257f-dk.dtb";
                    type     = "rawfile";
                    path     = "/tmp/stm32mp257f-dk.dtb.swu.tmp";
                    sha256   = "";
                }
            );

            scripts: (
                {
                    filename = "update-boot-a.sh";
                    type     = "shellscript";
                },
                {
                    filename = "post-update.sh";
                    type     = "shellscript";
                }
            );
        };

        copy2: {
            images: (
                {
                    filename   = "stm32mp257f-custom-image-@@MACHINE@@.rootfs.ext4.gz";
                    type       = "raw";
                    compressed = "zlib";
                    device     = "/dev/disk/by-partlabel/rootfs-b";
                    sha256     = "";
                },
                {
                    filename = "Image";
                    type     = "rawfile";
                    path     = "/tmp/Image.swu.tmp";
                    sha256   = "";
                },
                {
                    filename = "stm32mp257f-dk.dtb";
                    type     = "rawfile";
                    path     = "/tmp/stm32mp257f-dk.dtb.swu.tmp";
                    sha256   = "";
                }
            );

            scripts: (
                {
                    filename = "update-boot-b.sh";
                    type     = "shellscript";
                },
                {
                    filename = "post-update.sh";
                    type     = "shellscript";
                }
            );
        };
    };
};
