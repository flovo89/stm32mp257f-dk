# libubootenv — maps fw_printenv/fw_setenv to U-Boot's compiled-in env storage.
#
# U-Boot stm32mp25 defconfig:
#   CONFIG_ENV_IS_IN_MMC=y
#   CONFIG_ENV_SIZE=0x2000          (8 KB per copy)
#   CONFIG_ENV_OFFSET=0x900000      (primary:   MMC byte offset 9437184 = sector 18432)
#   CONFIG_ENV_OFFSET_REDUND=0x940000 (redundant: MMC byte offset 9699328 = sector 18944)
#
# Both offsets are ABSOLUTE from the start of /dev/mmcblk0, not relative to
# any partition.  The primary copy falls in the tail of the fip-b partition;
# the redundant copy falls inside the uenv partition — this matches the ST BSP
# layout and is intentional.
#
# Device          Offset       Size
/dev/mmcblk0      0x00900000   0x00002000
/dev/mmcblk0      0x00940000   0x00002000
