[Unit]
Description=Start Zephyr firmware on Cortex-M33 coprocessor
# st-m33firmware-load.service loads the default USBPD firmware after modules are ready.
# We run after it so the remoteproc sysfs is guaranteed to exist, then replace it with Zephyr.
After=sysinit.target local-fs.target st-m33firmware-load.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/m33-firmware-start.sh
ExecStop=/bin/sh -c 'echo stop > /sys/class/remoteproc/remoteproc0/state || true'
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
