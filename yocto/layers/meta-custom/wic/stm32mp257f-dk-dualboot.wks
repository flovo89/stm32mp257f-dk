# =============================================================================
# STM32MP257F-DK — 32 GB SD card, GPT, dual A/B OTA layout
# =============================================================================
#
# Partition map:
#  #  Label       FS      Size      Contents
#  1  fsbl1       raw     256 KB    TF-A BL2 (first copy)
#  2  fsbl2       raw     256 KB    TF-A BL2 (backup)
#  3  metadata1   raw       1 MB    FWU metadata primary
#  4  metadata2   raw       1 MB    FWU metadata backup
#  5  fip-a       raw       4 MB    FIP slot A (OP-TEE + U-Boot)
#  6  fip-b       raw       4 MB    FIP slot B (for FIP A/B update)
#  7  uenv        raw     512 KB    U-Boot environment (libubootenv)
#  8  boot-a      FAT32   64 MB    fitImage + DTB slot A
#  9  boot-b      FAT32   64 MB    fitImage + DTB slot B
# 10  rootfs-a    ext4     2 GB    Root filesystem slot A  <- initial
# 11  rootfs-b    ext4     2 GB    Root filesystem slot B  <- OTA target
# 12  userdata    ext4    24 GB    Persistent user/app data
#
# Note: raw binary partitions use --part-name (sets GPT name, no filesystem
# label operation) to avoid dosfslabel/e2label failures on non-FS content.
# =============================================================================

bootloader --ptable gpt

# TF-A BL2 — first and backup copies
part --source rawcopy --sourceparams="file=arm-trusted-firmware/tf-a-stm32mp257f-dk-optee-sdcard.stm32" --ondisk mmcblk --part-name fsbl1 --align 34 --size 256k
part --source rawcopy --sourceparams="file=arm-trusted-firmware/tf-a-stm32mp257f-dk-optee-sdcard.stm32" --ondisk mmcblk --part-name fsbl2 --align 256 --size 256k

# FWU metadata (TF-A reads these to locate the active FIP slot)
part --source rawcopy --sourceparams="file=arm-trusted-firmware/metadata.bin" --ondisk mmcblk --part-name metadata1 --align 256 --size 1024k
part --source rawcopy --sourceparams="file=arm-trusted-firmware/metadata.bin" --ondisk mmcblk --part-name metadata2 --align 256 --size 1024k

# FIP — contains OP-TEE + U-Boot BL33
part --source rawcopy --sourceparams="file=fip/fip-stm32mp257f-dk-optee-sdcard.bin" --ondisk mmcblk --part-name fip-a --align 256 --size 4096k
part --ondisk mmcblk --part-name fip-b --align 256 --size 4096k

# U-Boot environment (libubootenv / fw_env.config points here)
part --ondisk mmcblk --part-name uenv --align 256 --size 512k

# Boot partitions (FAT32 — kernel + DTB)
part --source bootimg-partition --ondisk mmcblk --fstype vfat --label boot-a --align 256 --size 65536k
part --ondisk mmcblk --fstype vfat --label boot-b --align 256 --size 65536k

# Root filesystem partitions (ext4)
part --source rootfs --ondisk mmcblk --fstype ext4 --label rootfs-a --align 256 --size 2097152k
part --ondisk mmcblk --fstype ext4 --label rootfs-b --align 256 --size 2097152k

# Persistent user data (~24 GB)
part --ondisk mmcblk --fstype ext4 --label userdata --align 256 --size 25165824k
