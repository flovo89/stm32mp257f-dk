/*
 * Board overlay for STM32MP257F-DK / Cortex-M33
 *
 * Defines the shared DDR window used for OpenAMP virtio rings and
 * sets the chosen nodes expected by the openamp_rsc_table subsystem.
 *
 * The address 0x81200000 and size 1 MB must match what the Linux
 * remoteproc / resource table reserves on the A35 side.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		zephyr,ipc_shm = &ipc_shmem;
		zephyr,ipc     = &mailbox;
	};

	ipc_shmem: memory@81200000 {
		compatible = "mmio-sram";
		reg = <0x81200000 DT_SIZE_M(1)>;
	};

	/*
	 * Quadrature encoder inputs (AMT103-D0500-I5000-S).  PF13/14/15 are
	 * GPIOF pins 13/14/15 — RIFSC CID2, so M33 can configure their MODER
	 * directly (unlike most other GPIO ports, which are CID1/A35-only).
	 */
	zephyr_user: zephyr,user {
		encoder-a-gpios = <&gpiof 13 GPIO_ACTIVE_HIGH>;
		encoder-b-gpios = <&gpiof 14 GPIO_ACTIVE_HIGH>;
		encoder-z-gpios = <&gpiof 15 GPIO_ACTIVE_HIGH>;
	};
};

&mailbox {
	status = "okay";
};

/*
 * USART6 defaults to pinctrl on PF13 (TX) / PF14 (RX), which conflicts with
 * the encoder A/B GPIOs above — the UART driver would reconfigure those pins
 * to AF7 at boot. USART6 is unused by this app (console is on UART5), so
 * disable it to free the pins.
 */
&usart6 {
	status = "disabled";
};
