/*
 * Board overlay for STM32MP257F-DK / Cortex-M33 — pulse generator + ADC sampler
 *
 * Defines the shared DDR window used for OpenAMP virtio rings and
 * sets the chosen nodes expected by the openamp_rsc_table subsystem.
 *
 * Address 0x81200000, size 1 MB — must match the Linux remoteproc reservation.
 *
 * Pins used by the application:
 *   PA5  — GPIOA pin 5, RIFSC CID2, AF8 = TIM2_CH4
 *           Hardware PWM output, 0–1 MHz, 50 % duty cycle.
 *           Configured directly in pulse_gen.c via MODER/AFRL registers.
 *   PF15 — GPIOF pin 15, RIFSC CID2, GPIO input with rising-edge EXTI interrupt.
 *           Trigger input: each rising edge fires a software ADC3 conversion.
 *           Declared via zephyr,user node below; read by sampler.c.
 *   PC7  — ADC3 INP9, RIFSC CID1 but stays ANALOG from power-on reset.
 *           Sampled by sampler.c on each PF15 rising edge (no MODER write needed).
 */

/ {
	chosen {
		zephyr,ipc_shm = &ipc_shmem;
		zephyr,ipc     = &mailbox;
	};

	ipc_shmem: memory@81200000 {
		compatible = "mmio-sram";
		reg = <0x81200000 DT_SIZE_M(1)>;
	};

	zephyr,user {
		/* PF15: rising-edge trigger input for ADC sampling (RIFSC CID2) */
		pulse-in-gpios = <&gpiof 15 GPIO_ACTIVE_HIGH>;
	};
};

&mailbox {
	status = "okay";
};

&gpiof {
	status = "okay";
};

/*
 * USART6 defaults to pinctrl on PF13/PF14; disable it so Zephyr does not
 * reconfigure those pins (they are used by Linux on the A35 side).
 */
&usart6 {
	status = "disabled";
};
