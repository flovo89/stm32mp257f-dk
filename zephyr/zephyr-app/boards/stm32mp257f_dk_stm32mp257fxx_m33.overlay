/*
 * Board overlay for STM32MP257F-DK / Cortex-M33
 *
 * Defines the shared DDR window used for OpenAMP virtio rings and
 * sets the chosen nodes expected by the openamp_rsc_table subsystem.
 *
 * The address 0x81200000 and size 1 MB must match what the Linux
 * remoteproc / resource table reserves on the A35 side.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		zephyr,ipc_shm = &ipc_shmem;
		zephyr,ipc     = &mailbox;
	};

	ipc_shmem: memory@81200000 {
		compatible = "mmio-sram";
		reg = <0x81200000 DT_SIZE_M(1)>;
	};

	/*
	 * Pin assignments — all 5 user-accessible CID2 pins are allocated:
	 *
	 * PA5  — GPIOA pin 5,  CID2, AF1=TIM2_CH1 → Phase A  (hardware PWM)
	 * PF13 — GPIOF pin 13, CID2, GPIO output  → Phase B  (software PWM, TIM2 CH2 ISR)
	 * PF14 — GPIOF pin 14, CID2, GPIO output  → Phase C  (software PWM, TIM2 CH3 ISR)
	 * PF15 — GPIOF pin 15, CID2, GPIO input   → Encoder A
	 * PG5  — GPIOG pin 5,  CID2, GPIO input   → Encoder B
	 *
	 * Bridge enable: no hardware pin — tie to 3V3, use duty=0 to disable.
	 * Encoder Z (index): not wired — PF15 repurposed for Encoder A.
	 * ADC inputs PC7/PF11: CID1 but work as analog (ANALOG = reset state).
	 *
	 * PWM pins are configured directly in pwm.c via MODER/AFR writes.
	 */
	zephyr_user: zephyr,user {
		encoder-a-gpios = <&gpiof 15 GPIO_ACTIVE_HIGH>;
		encoder-b-gpios = <&gpiog 5  GPIO_ACTIVE_HIGH>;
	};
};

&mailbox {
	status = "okay";
};

/*
 * USART6 defaults to pinctrl on PF13 (TX) / PF14 (RX), which conflicts with
 * the Phase B/C PWM outputs above. Disable it to prevent the UART driver
 * from reconfiguring those pins to AF7 at boot.
 */
&usart6 {
	status = "disabled";
};
